// Netlink thermal HAL from hardware/qcom-caf/thermal (lineage-23.2, 20a792e).
// kona is a legacy UM platform, so BoardConfigQcom.mk exports
// thermal-legacy-um (sysfs polling) and the device cannot opt out; this copy
// is the netlink HAL for the msm-5.15 kernel. Every file it installs has its
// own name: other trees build the QTI thermal HAL without a Soong namespace,
// and the same install paths would clash. hardware/lge labels the binary.
cc_binary {
    name: "android.hardware.thermal-service.qti.timelm",
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal-service.qti.timelm.rc"],
    vintf_fragments: ["android.hardware.thermal-service.qti.timelm.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.thermal-V2-ndk",
        "libcutils",
        "libutils",
        "liblog",
        "libnl",
    ],
    srcs: [
        "service.cpp",
        "thermal.cpp",
        "thermalConfig.cpp",
        "thermalCommon.cpp",
        "thermalUtilsNetlink.cpp",
        "thermalMonitorNetlink.cpp",
    ],
    // <linux/thermal.h> (thermal genl) comes from bionic's uapi headers.
    header_libs: [
        "liblog_headers",
        "libcutils_headers",
    ],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-DENABLE_THERMAL_NETLINK",
        "-fexceptions",
    ],
}
