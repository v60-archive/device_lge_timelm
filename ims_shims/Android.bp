install_symlink {
    name: "libbinder_ims_priv-app",
    system_ext_specific: true,
    installed_location: "priv-app/Ims6/lib/arm64/libbinder.so",
    symlink_target: "/system_ext/lib64/libbinder_ims.so",
}

