cc_library_shared {
    name: "libbinder_ims",
    srcs: ["libbinder_shim.cpp"],
    version_script: "libbinder_shim.map",
    system_ext_specific: true,
    strip: {
        none: true,
    },
    shared_libs: ["liblog"],
    cflags: ["-Wall", "-Wno-unused-parameter", "-fno-exceptions"],
}

