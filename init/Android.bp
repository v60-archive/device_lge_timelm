cc_library_static {
    name: "libinit_lge_kona",
    recovery_available: true,
    srcs: ["init_lge_kona.cpp"],
    include_dirs: [
        "system/libbase/include",
        "system/core/init"
    ],
    shared_libs: [
        "libbase",
    ]
}

// fstab
prebuilt_etc {
	name: "fstab.timelm",
	src: "fstab.timelm",
	vendor: true,
	ramdisk_available: true,
}

// Init scripts
sh_binary {
        name: "init.mdm.sh",
        src: "init.mdm.sh",
        vendor: true,
}

sh_binary {
        name: "init.qti.dcvs.sh",
        src: "init.qti.dcvs.sh",
        vendor: true,
}

// Init configuration files
prebuilt_etc {
	name: "init.lge.rc",
	src: "init.lge.rc",
	sub_dir: "init/hw",
	vendor: true,
}

prebuilt_etc {
        name: "init.lge.vendor.rc",
        src: "init.lge.vendor.rc",
        sub_dir: "init",
        vendor: true,
}

prebuilt_etc {
	name: "init.recovery.timelm.rc",
	src: "init.recovery.timelm.rc",
	sub_dir: "init",
	recovery: true,
}

prebuilt_etc {
        name: "init.target.rc",
        src: "init.target.rc",
        sub_dir: "init/hw",
        vendor: true,
}

prebuilt_etc {
        name: "init.timelm.rc",
        src: "init.timelm.rc",
        sub_dir: "init/hw",
        vendor: true,
}

prebuilt_etc {
        name: "init.vendor.sensors.rc",
        src: "init.vendor.sensors.rc",
        sub_dir: "init",
        vendor: true,
}

prebuilt_etc {
	name: "ueventd.lge.rc",
	src: "ueventd.lge.rc",
	vendor: true,
}
